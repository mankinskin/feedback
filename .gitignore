**/target/
**/.worktrees/

# Raw workstation telemetry; curated reports remain trackable.
**/.feedback/entries/
**/.workflow-tools/feedback/entries/
**/.test/**/executions/
**/.workflow-tools/test/**/executions/
scan_fingerprints.json

# Transient store controls; keep Cargo.lock and durable feedback trackable.
.*.lock
*.flock
.*-lock
*.tmp
.*.tmp-*
.tmp-*
move-locks/

# Deterministic transfer fixtures are source data, not telemetry.
!test-fixtures/**/.feedback/entries/